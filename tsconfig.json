{
  "compilerOptions": {
    "target":           "ES2020",
    "module":           "CommonJS",
    "lib":              ["ES2020"],
    "outDir":           "./dist",
    "rootDir":          "./src",
    "strict":           true,
    "esModuleInterop":  true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck":     true,
    "resolveJsonModule": true,
    "declaration":      true,
    "declarationMap":   true,
    "sourceMap":        true,
    "noUnusedLocals":   false,
    "noImplicitAny":    true,
    "strictNullChecks": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
