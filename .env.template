# =============================================================================
# Cambodia Business Hub — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=4000
API_PREFIX=/api/v1

# ─── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
# Railway format:  postgresql://USER:PASS@HOST:PORT/DB
# Render format:   postgresql://USER:PASS@HOST:PORT/DB?sslmode=require
DATABASE_URL=postgresql://cbh_user:your_password@localhost:5432/cbh_db
DATABASE_SSL=false            # set to true on Railway/Render

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=15m            # access token lifetime
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_BYTE_HEX_SECRET
JWT_REFRESH_EXPIRES_IN=7d     # refresh token lifetime

# ─── Supabase Storage (eKYC uploads) ─────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=cbh-kyc-documents  # bucket name — create in Supabase dashboard

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100            # requests per window per IP
AUTH_RATE_LIMIT_MAX=10        # stricter limit for /auth routes

# ─── File Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10           # max upload size in MB
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
